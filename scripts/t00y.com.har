          "content": {
            "size": 67273,
            "mimeType": "application/javascript",
            "text": "// Track checkbox column visibility state\r\nvar isCheckboxColumnVisible = false;\r\n\r\n// Reset checkbox selection state\r\nfunction resetSelectionState() {\r\n  checkedIDs = [];\r\n  isCheckboxColumnVisible = false;\r\n  $('#select-all-checkbox').prop('checked', false);\r\n  console.log('Selection state reset');\r\n}\r\n\r\n// Toggle checkbox column visibility in DataTables\r\nfunction toggleDataTableCheckbox(show) {\r\n  if (!$.fn.dataTable || !$.fn.dataTable.isDataTable('#table_files')) {\r\n    return;\r\n  }\r\n\r\n  var table = $('#table_files').DataTable();\r\n  if (table && table.column) {\r\n    // Both mobile and desktop now have checkbox as first column\r\n    table.column(0).visible(show);\r\n    isCheckboxColumnVisible = show;\r\n  }\r\n}\r\n\r\n// Note: Checkbox restoration is now handled in DataTable's drawCallback option\r\n\r\n// Function to select all items (all pages in DataTable)\r\nfunction selectAllItems() {\r\n  // First check if DataTable exists and has data\r\n  if (!$.fn.dataTable || !$.fn.dataTable.isDataTable('#table_files')) {\r\n    console.log('DataTable not initialized');\r\n    return checkedIDs;\r\n  }\r\n\r\n  var table = $('#table_files').DataTable();\r\n\r\n  // Show checkbox column first\r\n  toggleDataTableCheckbox(true);\r\n\r\n  // Get all checkbox elements from DataTable (including all pages)\r\n  var allCheckboxes = table.$('.checkbox-bulk-select-target');\r\n  console.log('Found checkboxes:', allCheckboxes.length);\r\n\r\n  // Select all checkboxes\r\n  allCheckboxes.prop('checked', true);\r\n  $('#select-all-checkbox').prop('checked', true);\r\n\r\n  // Clear and rebuild checkedIDs array with ALL items from ALL pages\r\n  checkedIDs = [];\r\n  allCheckboxes.each(function () {\r\n    var value = $(this).val();\r\n    if (value) {\r\n      checkedIDs.push(value);\r\n    }\r\n  });\r\n\r\n  console.log('Selected ALL items:', checkedIDs.length, 'items');\r\n  return checkedIDs;\r\n}\r\n\r\n// Handle row clicks (desktop only, not mobile)\r\n$(document).ready(function () {\r\n  // Row click to toggle checkbox\r\n  $(document).on('click', '#table_files tbody tr', function (e) {\r\n    // Skip if clicking on links, buttons, checkboxes, or their labels\r\n    if ($(e.target).is('a, button, input, label') ||\r\n        $(e.target).closest('a, button, .custom-control').length > 0) {\r\n      return;\r\n    }\r\n\r\n\r\n    var row = $(this);\r\n\r\n    // If checkbox column is hidden, show it first\r\n    if (!isCheckboxColumnVisible) {\r\n      toggleDataTableCheckbox(true);\r\n\r\n      // After column is shown, check this row's checkbox\r\n      setTimeout(function () {\r\n        var checkbox = row.find('.checkbox-bulk-select-target');\r\n        if (checkbox.length > 0) {\r\n          checkbox.prop('checked', true).trigger('change');\r\n        }\r\n      }, 100);\r\n    } else {\r\n      // Column is visible, just toggle checkbox\r\n      var checkbox = row.find('.checkbox-bulk-select-target');\r\n      if (checkbox.length > 0) {\r\n        checkbox.prop('checked', !checkbox.prop('checked')).trigger('change');\r\n      }\r\n    }\r\n  });\r\n\r\n  // Handle select all checkbox - only affects current page\r\n  $(document).on('change', '#select-all-checkbox', function () {\r\n    // Show column if hidden\r\n    if (!isCheckboxColumnVisible) {\r\n      toggleDataTableCheckbox(true);\r\n    }\r\n\r\n    var isChecked = this.checked;\r\n\r\n    // Toggle all checkboxes on current page\r\n    $('.checkbox-bulk-select-target').each(function () {\r\n      $(this).prop('checked', isChecked);\r\n    });\r\n\r\n    // Update selection array\r\n    updateBulkSelection();\r\n\r\n    // Update UI elements\r\n    checkOnclick();\r\n  });\r\n\r\n  // Handle individual checkbox change\r\n  $(document).on('change', '.checkbox-bulk-select-target', function () {\r\n    updateSingleCheckbox($(this));\r\n\r\n    console.log('Checkbox changed, checkedIDs:', checkedIDs.length);\r\n\r\n    // Update UI elements\r\n    checkOnclick();\r\n\r\n    // Update select-all state\r\n    var total = $('.checkbox-bulk-select-target').length;\r\n    var checked = $('.checkbox-bulk-select-target:checked').length;\r\n    $('#select-all-checkbox').prop('checked', total > 0 && total === checked);\r\n\r\n    // Show/hide checkbox column based on selection\r\n    if (checkedIDs.length === 0 && isCheckboxColumnVisible) {\r\n      toggleDataTableCheckbox(false);\r\n    } else if (checkedIDs.length > 0 && !isCheckboxColumnVisible) {\r\n      toggleDataTableCheckbox(true);\r\n    }\r\n  });\r\n});\r\n\r\n// Update bulk selection when checkbox changes\r\nfunction updateBulkSelection(checkboxElement) {\r\n  if (!checkboxElement) {\r\n    // If no specific checkbox, update based on all visible checkboxes\r\n    $('.checkbox-bulk-select-target').each(function () {\r\n      updateSingleCheckbox($(this));\r\n    });\r\n  } else {\r\n    // Update single checkbox\r\n    updateSingleCheckbox($(checkboxElement));\r\n  }\r\n\r\n  console.log('checkedIDs updated:', checkedIDs.length, 'items selected');\r\n\r\n  // Hide column if nothing selected\r\n  if (checkedIDs.length === 0 && isCheckboxColumnVisible) {\r\n    toggleDataTableCheckbox(false);\r\n    $('#select-all-checkbox').prop('checked', false);\r\n  } else if (checkedIDs.length > 0 && !isCheckboxColumnVisible) {\r\n    toggleDataTableCheckbox(true);\r\n  }\r\n}\r\n\r\n// Helper function to update single checkbox in array\r\nfunction updateSingleCheckbox(checkbox) {\r\n  var value = checkbox.val();\r\n  var isChecked = checkbox.prop('checked');\r\n  var index = checkedIDs.indexOf(value);\r\n\r\n  if (isChecked && index === -1) {\r\n    checkedIDs.push(value);\r\n  } else if (!isChecked && index !== -1) {\r\n    checkedIDs.splice(index, 1);\r\n  }\r\n}\r\n\r\n\r\nfunction getAuthCodeFromUrl() {\r\n  // 获取当前完整的 URL 字符串\r\n  const url = window.location.href;\r\n\r\n  // 使用正则表达式查找 auth_code= 后面的内容，直到遇到 & 符号或字符串末尾\r\n  const match = url.match(/auth_code=([^&]*)/);\r\n\r\n  // 如果找到了匹配项，match[1] 就是我们需要的值\r\n  if (match && match[1]) {\r\n    // decodeURIComponent 用于将编码过的 URL 字符（如 %2F）转回为普通字符（如 /）\r\n    return decodeURIComponent(match[1]);\r\n  }\r\n\r\n  // 如果没找到，返回 null\r\n  return null;\r\n}\r\n\r\nfunction parseLocationUrl() {\r\n  const result = {\r\n    path: \"\", // 路径部分\r\n    query: {}, // 查询参数部分\r\n    hash: \"\", // 哈希部分\r\n  };\r\n\r\n  // 使用 URL 构造函数解析 URL\r\n  const urlObj = window.location;\r\n\r\n  // 统一路径提取逻辑\r\n  if (urlObj.hash && urlObj.hash.startsWith(\"#/\")) {\r\n    // 从 hash 提取路径（hash 模式）\r\n    result.path = urlObj.hash.split(\"?\")[0].replace(\"#\", \"\");\r\n  } else {\r\n    // 从 pathname 提取路径（非 hash 模式）\r\n    result.path = urlObj.pathname;\r\n  }\r\n\r\n  // 提取哈希值（完整保留）\r\n  result.hash = urlObj.hash;\r\n\r\n  // 提取查询参数（优先处理 hash 中的参数）\r\n  const queryStringParts = [];\r\n  // 先添加 hash 中的查询参数（优先级高）\r\n  if (urlObj.hash.includes(\"?\")) {\r\n    queryStringParts.push(urlObj.hash.split(\"?\")[1]); // hash 中的查询参数\r\n  }\r\n  // 再添加 URL search 中的参数（优先级低）\r\n  if (urlObj.search) {\r\n    queryStringParts.push(urlObj.search.slice(1)); // 去掉 '?'\r\n  }\r\n\r\n  // 使用反向处理，让先添加的参数（hash中的）优先级更高\r\n  const queryParams = {};\r\n\r\n  // 先处理优先级低的（URL search），这样会被后面的覆盖\r\n  if (urlObj.search) {\r\n    const searchParams = new URLSearchParams(urlObj.search);\r\n    for (const [key, value] of searchParams) {\r\n      queryParams[key] = value;\r\n    }\r\n  }\r\n\r\n  // 再处理优先级高的（hash中的参数），覆盖前面的\r\n  if (urlObj.hash.includes(\"?\")) {\r\n    const hashQuery = urlObj.hash.split(\"?\")[1];\r\n    const hashParams = new URLSearchParams(hashQuery);\r\n    for (const [key, value] of hashParams) {\r\n      queryParams[key] = value;\r\n    }\r\n  }\r\n\r\n  result.query = queryParams;\r\n\r\n  return result;\r\n}\r\n\r\n\r\nfunction updateQueryParamsIncludingHash(newParams) {\r\n  const url = new URL(window.location.href);\r\n\r\n  // 确保 urlComponent 已初始化\r\n  if (typeof urlComponent === 'undefined' || !urlComponent) {\r\n    urlComponent = parseLocationUrl();\r\n  }\r\n\r\n  if (urlComponent.hash) {\r\n    // 如果需要修改 hash 中的查询参数\r\n    const [hashPath, hashQueryString] = urlComponent.hash.slice(1).split('?'); // 去掉 \"#\" 并分割路径和查询\r\n    const hashParams = new URLSearchParams(hashQueryString || '');\r\n\r\n    // 更新或添加新的参数到 hash 中\r\n    for (const [key, value] of Object.entries(newParams)) {\r\n      hashParams.set(key, value);\r\n    }\r\n\r\n    // 重建 hash 部分\r\n    url.hash = `#${hashPath}?${hashParams.toString()}`;\r\n  } else {\r\n    // 修改普通查询参数部分\r\n    const searchParams = url.searchParams;\r\n\r\n    // 更新或添加新的参数到查询中\r\n    for (const [key, value] of Object.entries(newParams)) {\r\n      searchParams.set(key, value);\r\n    }\r\n\r\n    // 更新 URL 的查询部分\r\n    url.search = searchParams.toString();\r\n  }\r\n  console.log(\"push\");\r\n  // 更新 URL，不刷新页面\r\n  history.pushState(newParams, null, url.toString());\r\n}\r\n\r\n\r\n// Helper function to load content with Authorization header\r\nfunction loadWithAuth(element, url, callback) {\r\n  $.ajax({\r\n    type: \"GET\",\r\n    url: url,\r\n    headers: getAjaxHeaders(),\r\n    success: function (data) {\r\n      $(element).html(data);\r\n      if (callback) callback();\r\n    }\r\n  });\r\n}\r\n\r\nvip_buy = function (vip_id) {\r\n  loadWithAuth(\r\n    ctmodal,\r\n    api_server + \"/api.php?item=vip&action=buy&vip_id=\" + vip_id + \"&pop=\" + popad,\r\n    function () {\r\n      rivets.bind($(ctmodal), { lang: lang_json });\r\n      $(ctmodal).modal();\r\n    }\r\n  );\r\n};\r\n\r\nmobile_vip_buy = function (vip_id) {\r\n  loadWithAuth(\r\n    ctmodal,\r\n    api_server + \"/api.php?item=vip&action=mobilebuy&vip_id=\" + vip_id + \"&pop=\" + popad,\r\n    function () {\r\n      rivets.bind($(ctmodal), { lang: lang_json });\r\n      $(ctmodal).modal();\r\n    }\r\n  );\r\n};\r\n\r\ncomplete_register = function () {\r\n  $.ajax({\r\n    type: \"GET\",\r\n    url: api_server + \"/api.php?item=account&action=need_complete_register\",\r\n    dataType: \"json\",\r\n    headers: getAjaxHeaders(),\r\n    success: function (res) {\r\n      if (res.code == 200) {\r\n        loadWithAuth(\r\n          ctmodal,\r\n          api_server + \"/api.php?item=file_act&action=complete_register\",\r\n          function () {\r\n            rivets.bind($(ctmodal), { lang: lang_json });\r\n            $(ctmodal).modal();\r\n          }\r\n        );\r\n      }\r\n    },\r\n  });\r\n};\r\n\r\ncheckOnclick = function () {\r\n  // Don't rebuild array - use existing checkedIDs maintained by updateSingleCheckbox\r\n  if (checkedIDs.length == 0) {\r\n    $(\"#file-control\").hide();\r\n    $(\"#select-all-checkbox\").prop(\"checked\", false);\r\n    $(\"#table_files_wrapper > .row-fluid:first-child\").fadeIn(500);\r\n  } else {\r\n    $(\"#selected_files_count\").html(checkedIDs.length);\r\n    $(\"#table_files_wrapper > .row-fluid:first-child\").hide();\r\n    $(\"#file-control\").fadeIn(500);\r\n  }\r\n};\r\n\r\nbulk_muti_down = function () {\r\n  if (checkedIDs.length == 0) {\r\n    // Auto select all items when none selected\r\n    selectAllItems();\r\n    // If still no items after select all, show error\r\n    if (checkedIDs.length == 0) {\r\n      cterror(lang_json[\"please_select_file_to_continue\"]);\r\n      return false;\r\n    }\r\n  }\r\n\r\n  var idlist = checkedIDs.join(\",\");\r\n  loadWithAuth(\r\n    ctmodal,\r\n    api_server +\r\n    \"/api.php?item=file_act&action=file_mutiple_download&uid=\" +\r\n    userid +\r\n    \"&file_id=\" +\r\n    idlist,\r\n    function () {\r\n      rivets.bind($(ctmodal), { lang: lang_json });\r\n      $(ctmodal).modal();\r\n    }\r\n  );\r\n};\r\n\r\nbulk_pack_down = function () {\r\n  if (checkedIDs.length == 0) {\r\n    // Auto select all items when none selected\r\n    selectAllItems();\r\n    // If still no items after select all, show error\r\n    if (checkedIDs.length == 0) {\r\n      cterror(lang_json[\"please_select_file_to_continue\"]);\r\n      return false;\r\n    }\r\n  }\r\n\r\n  var idlist = checkedIDs.join(\",\");\r\n  loadWithAuth(\r\n    ctmodal,\r\n    api_server +\r\n    \"/api.php?item=file_act&action=file_package_download&uid=\" +\r\n    userid +\r\n    \"&file_id=\" +\r\n    idlist,\r\n    function () {\r\n      rivets.bind($(ctmodal), { lang: lang_json });\r\n      $(ctmodal).modal();\r\n    }\r\n  );\r\n};\r\n\r\nbulk_file_save = function () {\r\n  if (checkedIDs.length == 0) {\r\n    // Auto select all items when none selected\r\n    selectAllItems();\r\n    // If still no items after select all, show error\r\n    if (checkedIDs.length == 0) {\r\n      cterror(lang_json[\"please_select_file_to_continue\"]);\r\n      return false;\r\n    }\r\n  }\r\n\r\n  var idlist = checkedIDs.join(\",\");\r\n\r\n  $.ajax({\r\n    type: \"GET\",\r\n    url:\r\n      api_server +\r\n      \"/api.php?item=file_act&action=file_save&task=file_save&uid=\" +\r\n      userid +\r\n      \"&file_id=\" +\r\n      idlist,\r\n    dataType: \"json\",\r\n    headers: getAjaxHeaders(),\r\n    success: function (res) {\r\n      if (res.code == 200) {\r\n        ctsuccess(res.message);\r\n      }\r\n      // 403 will be handled by global error handler\r\n      else {\r\n        cterror(res.message);\r\n      }\r\n    },\r\n  });\r\n};\r\n\r\nfile_openzip = function () {\r\n  loadWithAuth(\r\n    $(ctmodal),\r\n    api_server +\r\n    \"/api.php?item=file_act&action=file_unzip&task=readonly&uid=\" +\r\n    userid +\r\n    \"&file_id=\" +\r\n    file_id,\r\n    function () {\r\n      rivets.bind($(ctmodal), { lang: lang_json });\r\n      $(ctmodal).modal();\r\n    }\r\n  );\r\n};\r\n\r\nfile_unzip = function () {\r\n  loadWithAuth(\r\n    $(ctmodal),\r\n    api_server +\r\n    \"/api.php?item=file_act&action=file_unzip&uid=\" +\r\n    userid +\r\n    \"&file_id=\" +\r\n    file_id,\r\n    function () {\r\n      rivets.bind($(ctmodal), { lang: lang_json });\r\n      $(ctmodal).modal();\r\n    }\r\n  );\r\n};\r\n\r\nfile_zip = function () {\r\n  loadWithAuth(\r\n    $(ctmodal),\r\n    api_server +\r\n    \"/api.php?item=file_act&action=file_zip&uid=\" +\r\n    userid +\r\n    \"&file_id=\" +\r\n    file_id,\r\n    function () {\r\n      rivets.bind($(ctmodal), { lang: lang_json });\r\n      $(ctmodal).modal();\r\n    }\r\n  );\r\n};\r\n\r\nfile_play = function () {\r\n  loadWithAuth(\r\n    $(ctmodal),\r\n    api_server +\r\n    \"/api.php?item=file_act&action=file_play&uid=\" +\r\n    userid +\r\n    \"&file_id=\" +\r\n    file_id,\r\n    function () {\r\n      rivets.bind($(ctmodal), { lang: lang_json });\r\n      $(ctmodal).modal();\r\n    }\r\n  );\r\n};\r\n\r\nfile_save = function () {\r\n  $.ajax({\r\n    type: \"GET\",\r\n    url:\r\n      api_server +\r\n      \"/api.php?item=file_act&action=file_save&task=file_save&uid=\" +\r\n      userid +\r\n      \"&file_id=f\" +\r\n      file_id,\r\n    dataType: \"json\",\r\n    headers: getAjaxHeaders(),\r\n    success: function (res) {\r\n      if (res.code == 200) {\r\n        ctsuccess(res.message);\r\n      }\r\n      // 403 will be handled by global error handler\r\n      else {\r\n        cterror(res.message);\r\n      }\r\n    },\r\n  });\r\n};\r\n\r\nfree_vip_upgrade = function (file_size) {\r\n  $(ctmodal)\r\n    .load(\r\n      api_server +\r\n      \"/api.php?item=file_act&action=premium&file_size=\" +\r\n      file_size\r\n    )\r\n    .modal({ backdrop: \"static\" })\r\n    .draggable();\r\n};\r\n\r\nprepareSlowDown = function () {\r\n  // 先弹出 gowithapp 弹窗让用户选择下载方式\r\n  $(ctmodal).load(\r\n    api_server + \"/api.php?item=file_act&action=gowithapp\",\r\n    function () {\r\n      rivets.bind($(ctmodal), { lang: lang_json });\r\n      $(ctmodal).modal();\r\n    }\r\n  );\r\n};\r\n\r\nshowAppLoginRequired = function (ext, mb) {\r\n  var $modal = $(ctmodal);\r\n  var url =\r\n    api_server +\r\n    \"/api.php?item=file_act&action=app_login_required&ext=\" +\r\n    (ext || \"\") +\r\n    \"&mb=\" +\r\n    (mb || 0);\r\n\r\n  var loadModal = function () {\r\n    loadWithAuth($modal, url, function () {\r\n      rivets.bind($modal, { lang: lang_json });\r\n      window.app_login_url =\r\n        \"https://www.ctfile.com/login?ref=\" +\r\n        encodeURIComponent(top.location.href);\r\n      $modal.modal(\"show\");\r\n    });\r\n  };\r\n\r\n  // 移除之前的事件处理器避免重复绑定\r\n  $modal.off(\"hidden.bs.modal.showAppLoginRequired\");\r\n\r\n  if ($modal.is(\":visible\")) {\r\n    // 等待modal完全关闭后再加载新内容\r\n    $modal.one(\"hidden.bs.modal.showAppLoginRequired\", loadModal);\r\n    $modal.modal(\"hide\");\r\n  } else {\r\n    loadModal();\r\n  }\r\n};\r\n\r\nfunction file_down(mb, app) {\r\n  // 如果是免费下载（app === 0），先显示倒计时\r\n  if (app === 0) {\r\n    startDownloadCountdown(mb);\r\n  } else {\r\n    // 客户端下载或VIP下载，直接执行\r\n    file_down_init(file_id, 0, mb, app);\r\n  }\r\n}\r\n\r\nfunction dir_down(mb, app) {\r\n  // Auto select all if no items selected\r\n  if (checkedIDs.length == 0) {\r\n    checkedIDs = selectAllItems();\r\n    // Check again after selection\r\n    if (checkedIDs.length == 0) {\r\n      alert(lang.no_selected_file);\r\n      return;\r\n    }\r\n  }\r\n  file_down_init(0, folder_id, mb, app);\r\n}\r\n\r\nfunction CloseAndScrollToVIP() {\r\n  if ($(ctmodal).hasClass(\"show\")) {\r\n    $(ctmodal).modal(\"hide\");\r\n  }\r\n  var vipSection = $(\"#vip-membership-section\");\r\n  if (vipSection.length > 0) {\r\n    $(\"html, body\").animate({\r\n      scrollTop: vipSection.offset().top - 100\r\n    });\r\n  }\r\n}\r\n\r\n// 全局倒计时变量\r\nvar downloadCountdownTimer = null;\r\nvar downloadCountdownSeconds = 60;\r\nvar downloadCountdownInitialSeconds = 60; // 记录初始值用于进度计算\r\nvar downloadCountdownPlatform = 0; // 记录平台类型（0=桌面，1=移动）\r\nvar downloadCountdownPaused = false; // 标记倒计时是否已暂停\r\nvar visibilityChangeHandler = null; // 页面可见性监听器引用\r\n\r\n// 启动下载倒计时\r\nfunction startDownloadCountdown(mb) {\r\n  // 先关闭可能存在的弹窗（如 gowithapp 弹窗）\r\n  if ($(ctmodal).hasClass(\"show\")) {\r\n    $(ctmodal).modal(\"hide\");\r\n  }\r\n\r\n  // 如果 wait_seconds 为 0，直接开始下载，跳过倒计时\r\n  if (wait_seconds === 0) {\r\n    executeDownload(mb);\r\n    return;\r\n  }\r\n\r\n  // 清除可能存在的旧计时器\r\n  if (downloadCountdownTimer) {\r\n    clearInterval(downloadCountdownTimer);\r\n    downloadCountdownTimer = null;\r\n  }\r\n\r\n  // 移除旧的可见性监听器\r\n  if (visibilityChangeHandler) {\r\n    document.removeEventListener('visibilitychange', visibilityChangeHandler);\r\n    visibilityChangeHandler = null;\r\n  }\r\n\r\n  // 保存平台类型\r\n  downloadCountdownPlatform = mb;\r\n  downloadCountdownPaused = false;\r\n\r\n  // 重置倒计时秒数 - 优先使用 API 返回的 wait_seconds，否则使用默认值\r\n  // 优先级：1. API返回的wait_seconds  2. 模板设置的DOWNLOAD_COUNTDOWN_SECONDS  3. 默认60秒\r\n  downloadCountdownInitialSeconds = wait_seconds || window.DOWNLOAD_COUNTDOWN_SECONDS || 60;\r\n  downloadCountdownSeconds = downloadCountdownInitialSeconds;\r\n\r\n  // 切换UI显示 - 使用Bootstrap的d-none/d-flex类\r\n  if (mb === 1) {\r\n    // 移动版\r\n    $('#freeDownloadNormalMobile').removeClass('d-flex').addClass('d-none');\r\n    $('#freeDownloadCountdownMobile').removeClass('d-none').addClass('d-flex');\r\n    updateCountdownDisplay(mb);\r\n  } else {\r\n    // 桌面版\r\n    $('#freeDownloadNormal').removeClass('d-flex').addClass('d-none');\r\n    $('#freeDownloadCountdown').removeClass('d-none').addClass('d-flex');\r\n    updateCountdownDisplay(mb);\r\n  }\r\n\r\n  // 启动倒计时\r\n  downloadCountdownTimer = setInterval(function() {\r\n    downloadCountdownSeconds--;\r\n    updateCountdownDisplay(mb);\r\n\r\n    // 倒计时结束\r\n    if (downloadCountdownSeconds <= 0) {\r\n      clearInterval(downloadCountdownTimer);\r\n      downloadCountdownTimer = null;\r\n\r\n      // 执行实际下载\r\n      executeDownload(mb);\r\n    }\r\n  }, 1000);\r\n\r\n  // 注册页面可见性监听器\r\n  visibilityChangeHandler = function() {\r\n    if (document.hidden) {\r\n      // 页面隐藏，暂停倒计时\r\n      pauseDownloadCountdown();\r\n    } else {\r\n      // 页面显示，恢复倒计时\r\n      resumeDownloadCountdown();\r\n    }\r\n  };\r\n  document.addEventListener('visibilitychange', visibilityChangeHandler);\r\n}\r\n\r\n// 暂停下载倒计时\r\nfunction pauseDownloadCountdown() {\r\n  if (downloadCountdownTimer && !downloadCountdownPaused) {\r\n    clearInterval(downloadCountdownTimer);\r\n    downloadCountdownTimer = null;\r\n    downloadCountdownPaused = true;\r\n    console.log('倒计时已暂停，剩余秒数:', downloadCountdownSeconds);\r\n  }\r\n}\r\n\r\n// 恢复下载倒计时\r\nfunction resumeDownloadCountdown() {\r\n  if (downloadCountdownPaused && downloadCountdownSeconds > 0) {\r\n    downloadCountdownPaused = false;\r\n\r\n    // 重新启动定时器，从当前剩余秒数继续\r\n    downloadCountdownTimer = setInterval(function() {\r\n      downloadCountdownSeconds--;\r\n      updateCountdownDisplay(downloadCountdownPlatform);\r\n\r\n      // 倒计时结束\r\n      if (downloadCountdownSeconds <= 0) {\r\n        clearInterval(downloadCountdownTimer);\r\n        downloadCountdownTimer = null;\r\n\r\n        // 执行实际下载\r\n        executeDownload(downloadCountdownPlatform);\r\n      }\r\n    }, 1000);\r\n\r\n    console.log('倒计时已恢复，剩余秒数:', downloadCountdownSeconds);\r\n  }\r\n}\r\n\r\n// 更新倒计时显示\r\nfunction updateCountdownDisplay(mb) {\r\n  // 动态计算进度百分比，使用初始倒计时秒数\r\n  var progress = (downloadCountdownSeconds / downloadCountdownInitialSeconds) * 100;\r\n\r\n  if (mb === 1) {\r\n    // 移动版\r\n    $('#countdownNumberMobile').text(downloadCountdownSeconds);\r\n    $('#countdownProgressMobile').css('width', progress + '%');\r\n  } else {\r\n    // 桌面版\r\n    $('#countdownNumber').text(downloadCountdownSeconds);\r\n    $('#countdownProgress').css('width', progress + '%');\r\n  }\r\n}\r\n\r\n// 执行实际下载\r\nfunction executeDownload(mb) {\r\n  // 移除页面可见性监听器\r\n  if (visibilityChangeHandler) {\r\n    document.removeEventListener('visibilitychange', visibilityChangeHandler);\r\n    visibilityChangeHandler = null;\r\n  }\r\n\r\n  // 重置倒计时状态\r\n  downloadCountdownPaused = false;\r\n\r\n  // 隐藏倒计时界面，恢复原始下载按钮，并修改按钮文本\r\n  if (mb === 1) {\r\n    // 移动版\r\n    $('#freeDownloadCountdownMobile').removeClass('d-flex').addClass('d-none');\r\n    $('#freeDownloadNormalMobile').removeClass('d-none').addClass('d-flex');\r\n    // 修改移动版按钮文本\r\n    $('#freeDownloadNormalMobile button').html('<i class=\"fas fa-check-circle mr-1\"></i>' + lang_json[\"file\"][\"download_started\"]);\r\n  } else {\r\n    // 桌面版\r\n    $('#freeDownloadCountdown').removeClass('d-flex').addClass('d-none');\r\n    $('#freeDownloadNormal').removeClass('d-none').addClass('d-flex');\r\n    // 修改桌面版按钮文本\r\n    $('#freeDownloadNormal button').html('<i class=\"fas fa-check-circle mr-1\"></i>' + lang_json[\"file\"][\"download_started\"]);\r\n  }\r\n\r\n  // 执行下载\r\n  file_down_init(file_id, 0, mb, 0);\r\n}\r\n\r\nfunction file_down_init(file_id, folder_id, mb, app) {\r\n\r\n\r\n  var acheck = mb\r\n    ? $(\"#mobile-500x200:visible\").length\r\n    : $(\"#760ad:visible\").length;\r\n\r\n  $.ajax({\r\n    type: \"GET\",\r\n    url: api_server +\r\n      \"/get_file_url.php?uid=\" +\r\n      userid +\r\n      \"&fid=\" +\r\n      file_id +\r\n      \"&folder_id=\" +\r\n      folder_id +\r\n      \"&share_id=\" +\r\n      share_id +\r\n      \"&file_chk=\" +\r\n      file_chk +\r\n      \"&start_time=\" +\r\n      start_time +\r\n      \"&wait_seconds=\" +\r\n      wait_seconds +\r\n      \"&mb=\" +\r\n      mb +\r\n      \"&app=\" +\r\n      app +\r\n      \"&acheck=\" +\r\n      acheck +\r\n      \"&verifycode=\" +\r\n      verifycode +\r\n      \"&rd=\" +\r\n      Math.random(),\r\n    dataType: \"json\",\r\n    headers: getAjaxHeaders(),\r\n    success: async function (data) {\r\n\r\n      if (data.code == 302) {\r\n        window.location.href = data.url;\r\n      }\r\n\r\n      if (data.code == 215) {\r\n        alert(data.message);\r\n      }\r\n\r\n      if (data.code == 216) {\r\n        loadWithAuth(\r\n          $(ctmodal),\r\n          api_server +\r\n          \"/api.php?item=file_act&action=download_queue&uid=\" +\r\n          userid +\r\n          \"&fid=\" +\r\n          file_id +\r\n          \"&folder_id=\" +\r\n          folder_id +\r\n          \"&share_id=\" +\r\n          share_id +\r\n          \"&mb=\" +\r\n          mb,\r\n          function () {\r\n            rivets.bind($(ctmodal), { lang: lang_json });\r\n            $(ctmodal).modal();\r\n          }\r\n        );\r\n      }\r\n\r\n      if (data.code == 217) {\r\n        loadWithAuth(\r\n          $(ctmodal),\r\n          api_server +\r\n          \"/api.php?item=file_act&action=download_limit&uid=\" +\r\n          userid +\r\n          \"&fid=\" +\r\n          file_id +\r\n          \"&folder_id=\" +\r\n          folder_id +\r\n          \"&share_id=\" +\r\n          share_id +\r\n          \"&mb=\" +\r\n          mb +\r\n          \"&waittime=\" +\r\n          data.waittime,\r\n          function () {\r\n            rivets.bind($(ctmodal), { lang: lang_json });\r\n            $(ctmodal).modal();\r\n          }\r\n        );\r\n      }\r\n\r\n      if (data.code == 218) {\r\n        // 倒计时未结束\r\n        cterror(data.message || \"请等待倒计时结束后再下载\");\r\n      }\r\n\r\n      if (data.code == 219) {\r\n        // 可执行文件需要登录下载\r\n        showAppLoginRequired(data.file_ext, mb);\r\n      }\r\n\r\n      if (data.code == 215 || data.code == 216 || data.code == 217) {\r\n        if (\r\n          $(\"#doubleclick_log\").length > 0 &&\r\n          $(\"#doubleclick_log\").attr(\"data\").length > 20\r\n        ) {\r\n          setTimeout(function () {\r\n            $(\"#doubleclick_log\").attr(\"data\", data.confirm_url);\r\n          }, 10000);\r\n        }\r\n\r\n        if (data.pop > 0) {\r\n          setTimeout(function () {\r\n            important_window();\r\n          }, 4000);\r\n        }\r\n      }\r\n\r\n      if (data.code == 200) {\r\n        if (\r\n          $(\"#doubleclick_log\").length > 0 &&\r\n          $(\"#doubleclick_log\").attr(\"data\").length > 20\r\n        ) {\r\n          setTimeout(function () {\r\n            $(\"#doubleclick_log\").attr(\"data\", data.confirm_url);\r\n          }, 10000);\r\n        }\r\n\r\n        if (app) {\r\n          if (!mb) {\r\n            $(\r\n              '<div style=\"display:none;\"><iframe src=\"ctfile://xturl' +\r\n              data.xt_link +\r\n              '\" frameborder=\"0\" scrolling=\"no\"></iframe></div>'\r\n            ).appendTo(\"#main-content\");\r\n            //window.location.href = \"ctfile://xturl\" + data.xt_link;\r\n            $(ctmodal).load(\r\n              api_server +\r\n              \"/api.php?item=file_act&action=xt_downlink&xtlink=\" +\r\n              data.xt_link,\r\n              function () {\r\n                rivets.bind($(ctmodal), { lang: lang_json });\r\n                $(ctmodal).modal();\r\n              }\r\n            );\r\n          } else {\r\n            window.location.href =\r\n              \"ctfile://inapp.ctfile.com/app.php?||xt||ctfile://xturl\" +\r\n              data.xt_link;\r\n            $(\"#xtlink_input\").val(\"ctfile://xturl\" + data.xt_link);\r\n            $(\"#xtlink_copy_alert\").show();\r\n          }\r\n        } else {\r\n\r\n\r\n          if (data.pop > 0) {\r\n            setTimeout(function () {\r\n              important_window();\r\n            }, 4000);\r\n            //  important_window();\r\n          }\r\n\r\n          // var isInsideDomain =\r\n          //   window.location.host.indexOf(\".ctfile.com\") > 0 ? true : false;\r\n          //if (data.xhr && isInsideDomain && isFetchAPISupported()) {\r\n          if (data.xhr && await isFetchAPISupported(data.file_size)) {\r\n            downloadFile(data);\r\n          } else if (data.downurl) {\r\n            setTimeout(function () {\r\n              window.location.href = data.downurl;\r\n            }, 100);\r\n          }\r\n        }\r\n      }\r\n    }\r\n  });\r\n}\r\n\r\nvar _popup_ispoped = false;\r\nfunction important_window() {\r\n  var _popheight = screen.height * 0.8;\r\n  var _popwidth = screen.height * 0.8;\r\n\r\n  if (!_popup_ispoped) {\r\n    _popup_ispoped = true;\r\n    myWindow = window.open(\r\n      \"http://mydisplay.ctfile.com/popjump.php?r=\" + Math.random(),\r\n      \"\",\r\n      \"width=\" +\r\n      _popwidth +\r\n      \",height=\" +\r\n      _popheight +\r\n      \",top=\" +\r\n      (screen.height - _popheight) +\r\n      \",left=\" +\r\n      (screen.width - _popwidth)\r\n    );\r\n    myWindow.blur();\r\n  }\r\n}\r\n\r\nfunction is_weixn_qq() {\r\n  var ua = navigator.userAgent.toLowerCase();\r\n  var ref = document.referrer;\r\n  if (ua.match(/MicroMessenger|QQ\\/|weibo|alipay|tieba|zhihu|baidu/i)) {\r\n    return true;\r\n  }\r\n\r\n  if (ref.match(/nativeapp\\.toutiao|test\\.toutiao/i)) {\r\n    return true;\r\n  }\r\n\r\n  return false;\r\n}\r\n\r\nfunction is_ios() {\r\n  var ua = navigator.userAgent.toLowerCase();\r\n  if (ua.match(/iphone|ipad/i)) {\r\n    return true;\r\n  }\r\n  return false;\r\n}\r\n\r\nfunction mobileapp_predownload() {\r\n  $(\"#doubleclick_log\").attr(\r\n    \"data\",\r\n    \"https://doubleclick.ctfile.com/vip_log.php\"\r\n  );\r\n}\r\n\r\nfunction changeCaptcha() {\r\n  $(\"#captcha-img\").attr(\r\n    \"src\",\r\n    api_server + \"/randcodeV2_login.php?r=\" + Math.random()\r\n  );\r\n}\r\n\r\nfunction loadCaptcha() {\r\n  if ($(\"#captcha-img:visible\").length == 0) {\r\n    $(\"#captcha-img\").show();\r\n    changeCaptcha();\r\n  }\r\n}\r\n\r\nfunction hide_loader() {\r\n  $('#loading').hide();\r\n}\r\n\r\n\r\nctsuccess = function (content) {\r\n  // Remove any existing toast classes\r\n  $(\".toast\").removeClass(\"toast-error toast-info\").addClass(\"toast-success\");\r\n  $(\"#toast-title\").html(lang_json[\"action_success\"]);\r\n  $(\"#toast-message\").html(content);\r\n  $(\".toast\").toast(\"show\");\r\n  setTimeout(\"checkOnclick()\", 1000);\r\n};\r\n\r\ncterror = function (content) {\r\n  // Remove any existing toast classes\r\n  $(\".toast\").removeClass(\"toast-success toast-info\").addClass(\"toast-error\");\r\n  $(\"#toast-title\").html(lang_json[\"action_failed\"]);\r\n  $(\"#toast-message\").html(content);\r\n  $(\".toast\").toast(\"show\");\r\n};\r\n\r\nctinfo = function (content) {\r\n  // Remove any existing toast classes\r\n  $(\".toast\").removeClass(\"toast-success toast-error\").addClass(\"toast-info\");\r\n  $(\"#toast-title\").html(lang_json[\"information\"]);\r\n  $(\"#toast-message\").html(content);\r\n  $(\".toast\").toast(\"show\");\r\n};\r\n\r\nfunction user_logout() {\r\n  // Clear session token from localStorage\r\n  localStorage.removeItem('session_token');\r\n  // Clear all localStorage if needed\r\n  // localStorage.clear();\r\n\r\n  // Redirect to logout\r\n  top.location.href = \"https://www.ctfile.com/p/login?action=logout&ref=\" + encodeURIComponent(top.location.href);\r\n}\r\n\r\nvar ctmodal = \"#infoModal\";\r\nvar checkedIDs = new Array();\r\n\r\nvar filequery = null;\r\nvar file_id = 0;\r\nvar folder_id = 0;\r\nvar share_id = \"\";  // Share ID for share contexts\r\nvar file_chk = null;\r\nvar start_time = 0;  // 下载开始时间（用于倒计时验证）\r\nvar wait_seconds = 0;  // 需要等待的秒数（用于倒计时验证）\r\nvar verifycode = null;\r\nvar userid = 0;\r\nvar passcode = \"\";\r\nvar popad = 0;  // Global popads value for VIP plan control\r\nvar api_server = \"https://webapi.ctfile.com\";\r\nvar lang_json = null;\r\nvar pass_autocomplete = 0;\r\nvar main_domain = \".ctfile.com\";\r\nvar urlComponent = {\r\n  path: '',    // 路径部分\r\n  query: {},   // 查询参数部分\r\n  hash: ''     // 哈希部分\r\n};\r\n\r\nfunction changeLanguage() {\r\n  var selected_lang = $(\"#languageSelect option:selected\").val();\r\n  if (selected_lang != lang_json[\"language\"]) {\r\n    var isInsideDomain =\r\n      window.location.host.indexOf(main_domain) > 0 ? true : false;\r\n    if (isInsideDomain) {\r\n      document.cookie =\r\n        \"lang=\" +\r\n        selected_lang +\r\n        \"; expires=Wed, 05 Aug 2050 23:00:00 UTC; path=/; domain=\" + main_domain;\r\n\r\n      webpage_reload();\r\n    } else {\r\n      $.ajax({\r\n        type: \"GET\",\r\n        url: api_server + \"/change_lang.php?lang=\" + selected_lang,\r\n        dataType: \"json\",\r\n        headers: getAjaxHeaders(),\r\n        success: function (res) {\r\n          webpage_reload();\r\n        },\r\n      });\r\n    }\r\n  }\r\n}\r\n\r\nfunction webpage_reload() {\r\n  init_load();\r\n  // 检查是否有下载状态\r\n  if (window.downloadStatus && window.downloadStatus.isDownloading && window.downloadStatus.bytesReceived > 0) {\r\n    if (typeof restartDownload === 'function') {\r\n      restartDownload();\r\n    }\r\n  }\r\n}\r\n\r\nrivets.formatters.langcompare = function (value, item) {\r\n  if (value == item) {\r\n    return \"selected\";\r\n  }\r\n  return null;\r\n};\r\n\r\n//no longer use this\r\nfunction page_right_register() {\r\n  $(\"#register-form\").ajaxForm({\r\n    dataType: \"json\",\r\n    url: api_server + \"/#\",\r\n    headers: getAjaxHeaders(),\r\n    success: function (data) {\r\n      if (data.code == 200) {\r\n        webpage_reload();\r\n      } else {\r\n        $(\"#reg-response-msg\").html(data.message);\r\n        $(\"#reg-response-info\").show();\r\n      }\r\n    },\r\n    beforeSubmit: function (arr, $form, options) {\r\n      if ($form.find(\"#reg-email\").val() == \"\") {\r\n        $(\"#reg-response-msg\").html(lang_json[\"regform\"][\"please_enter_email\"]);\r\n        $(\"#reg-response-info\").show();\r\n        return false;\r\n      }\r\n\r\n      if (\r\n        /^\\w+([\\.-]?\\w+)*@\\w+([\\.-]?\\w+)*(\\.\\w{2,3})+$/.test(\r\n          $form.find(\"#reg-email\").val()\r\n        ) == false\r\n      ) {\r\n        $(\"#reg-response-msg\").html(\r\n          lang_json[\"account\"][\"please_enter_valid_email\"]\r\n        );\r\n        $(\"#reg-response-info\").show();\r\n        return false;\r\n      }\r\n\r\n      if ($form.find(\"#reg-password\").val() == \"\") {\r\n        $(\"#reg-response-msg\").html(\r\n          lang_json[\"regform\"][\"please_enter_password\"]\r\n        );\r\n        $(\"#reg-response-info\").show();\r\n        return false;\r\n      }\r\n\r\n      var v = $.trim($form.find(\"#reg-password\").val());\r\n      if (v.length < 6 || v.length > 30) {\r\n        $(\"#reg-response-msg\").html(\r\n          lang_json[\"regform\"][\"password_length_limited\"]\r\n        );\r\n        $(\"#reg-response-info\").show();\r\n        return false;\r\n      }\r\n\r\n      if (\r\n        $form.find(\"#reg-password\").val() !=\r\n        $form.find(\"#reg-confirm-password\").val()\r\n      ) {\r\n        $(\"#reg-response-msg\").html(lang_json[\"regform\"][\"password_not_match\"]);\r\n        $(\"#reg-response-info\").show();\r\n        return false;\r\n      }\r\n\r\n      if (/^\\d+$/.test(v)) {\r\n        $(\"#reg-response-msg\").html(\r\n          lang_json[\"regform\"][\"password_must_includes\"]\r\n        );\r\n        $(\"#reg-response-info\").show();\r\n        return false;\r\n      }\r\n\r\n      if (/^[a-z]+$/i.test(v)) {\r\n        $(\"#reg-response-msg\").html(\r\n          lang_json[\"regform\"][\"password_must_includes\"]\r\n        );\r\n        $(\"#reg-response-info\").show();\r\n        return false;\r\n      }\r\n\r\n      if (!/^[A-Za-z0-9]+$/.test(v)) {\r\n        $(\"#reg-response-msg\").html(\r\n          lang_json[\"regform\"][\"password_only_includes\"]\r\n        );\r\n        $(\"#reg-response-info\").show();\r\n        return false;\r\n      }\r\n\r\n      if (!$form.find(\"#reg-register-checkbox\").prop(\"checked\")) {\r\n        $(\"#reg-response-msg\").html(lang_json[\"regform\"][\"please_read_policy\"]);\r\n        $(\"#reg-response-info\").show();\r\n        return false;\r\n      }\r\n\r\n      if ($form.find(\"#reg-captcha\").val() == \"\") {\r\n        $(\"#reg-response-msg\").html(\r\n          lang_json[\"regform\"][\"please_enter_captcha\"]\r\n        );\r\n        $(\"#reg-response-info\").show();\r\n        return false;\r\n      }\r\n    },\r\n  });\r\n}\r\nfunction load_file(query, path) {\r\n  $.ajax({\r\n    type: \"GET\",\r\n    url:\r\n      api_server +\r\n      \"/getfile.php?path=\" +\r\n      path +\r\n      \"&f=\" +\r\n      query +\r\n      \"&passcode=\" +\r\n      passcode +\r\n      \"&r=\" +\r\n      Math.random() +\r\n      \"&ref=\" +\r\n      encodeURIComponent(document.referrer) +\r\n      \"&url=\" +\r\n      encodeURIComponent(top.location.href),\r\n    dataType: \"json\",\r\n    headers: getAjaxHeaders(),\r\n    success: function (res) {\r\n      if (res.lang) {\r\n        lang_json = res.lang;\r\n      }\r\n\r\n      if (res.file) {\r\n        file_id = res.file.file_id;\r\n        file_chk = res.file.file_chk;\r\n        start_time = res.file.start_time || 0;  // 下载开始时间\r\n        wait_seconds = res.file.wait_seconds || 0;  // 需要等待的秒数\r\n        userid = res.file.userid;\r\n        verifycode = res.file.verifycode;\r\n        popad = res.file.popad || 0;  // Save global popads value\r\n      }\r\n\r\n      if (res.code == 200 && res.file) {\r\n        //ok to login\r\n        var file_template = \"file-content.php\";\r\n        if (res.file.is_mb) {\r\n          file_template = \"file-content-mb.php\";\r\n        }\r\n\r\n        $(\"#main-content\").load(\r\n          template_url +\r\n          \"/template/\" +\r\n          file_template +\r\n          \"?pop=\" +\r\n          res.file.popad,\r\n          function () {\r\n            document.title = res.file.page_title;\r\n            rivets.bind($(\"body\"), { file: res.file, lang: lang_json });\r\n            loadtextad();\r\n            hide_loader();\r\n            // page_right_register();\r\n          }\r\n        );\r\n\r\n        if (res.file.doubleclick_url) {\r\n          $(\"#doubleclick_log\").attr(\"data\", res.file.doubleclick_url);\r\n        }\r\n\r\n        if (res.file.xtredirect && res.file.forceApp) {\r\n          setTimeout(function () {\r\n            window.location.href = \"ctfile://\" + res.file.xtredirect;\r\n          }, 3000);\r\n        }\r\n      } else {\r\n        error_code_handler(res);\r\n      }\r\n    },\r\n  });\r\n}\r\n\r\nfunction loadtextad() {\r\n  $.ajax({\r\n    type: \"GET\",\r\n    url: api_server + \"/ad_display.php?ad_pos=0&r=\" + Math.random(),\r\n    dataType: \"json\",\r\n    success: function (res) {\r\n      if (res.code == 200) {\r\n        $(\"#ad_text\").html(res.content);\r\n      }\r\n    },\r\n  });\r\n}\r\n\r\nfunction error_code_handler(res) {\r\n  if (res.code == 423) {  // 423 now means password required (was 401)\r\n    if (res.file.autocomplete) {\r\n      pass_autocomplete = res.file.autocomplete;\r\n    }\r\n    //request passcode\r\n    $(\"#main-content\").load(\r\n      template_url + \"/template/file-passcode.php\",\r\n      function () {\r\n        rivets.bind($(\"body\"), { file: res.file, lang: lang_json });\r\n        hide_loader();\r\n        loadtextad();\r\n        if (res.file.autocomplete == 5) {\r\n          auto_submitpasscode();\r\n        }\r\n      }\r\n    );\r\n    document.title = lang_json[\"webtitles\"][\"passcode\"];\r\n  } else {\r\n    $(\"#main-content\").load(\r\n      template_url + \"/template/file-404.php\",\r\n      function () {\r\n        rivets.bind($(\"body\"), { file: res.file, lang: lang_json });\r\n        hide_loader();\r\n        loadtextad();\r\n      }\r\n    );\r\n    document.title = lang_json[\"webtitles\"][\"filenotfound\"];\r\n  }\r\n}\r\n\r\nfunction load_subdir(subdir_id, folder_key) {\r\n  // If folder_key is provided, include it in the URL params (for share contexts)\r\n  if (folder_key) {\r\n    updateQueryParamsIncludingHash({ \"d\": subdir_id, \"fk\": folder_key });\r\n  } else {\r\n    updateQueryParamsIncludingHash({ \"d\": subdir_id });\r\n  }\r\n}\r\n\r\nfunction load_uri(uri) {\r\n  if (urlComponent.hash) {\r\n    history.pushState(uri, null, \"#\" + uri);\r\n  }\r\n  else {\r\n    top.location.href = uri;\r\n  }\r\n}\r\n\r\nfunction load_share(query, path) {\r\n  var folder_key = urlComponent.query[\"fk\"] || \"\"; // Get folder key from URL parameter\r\n\r\n  // Set global share_id\r\n  share_id = query;\r\n\r\n  $.ajax({\r\n    type: \"GET\",\r\n    url:\r\n      api_server +\r\n      \"/getshare.php?path=\" +\r\n      path +\r\n      \"&s=\" +\r\n      query +\r\n      \"&folder_id=\" +\r\n      urlComponent.query[\"d\"] +\r\n      \"&fk=\" +\r\n      folder_key +\r\n      \"&passcode=\" +\r\n      passcode +\r\n      \"&r=\" +\r\n      Math.random() +\r\n      \"&ref=\" +\r\n      encodeURIComponent(document.referrer) +\r\n      \"&url=\" +\r\n      encodeURIComponent(top.location.href),\r\n    dataType: \"json\",\r\n    headers: getAjaxHeaders(),\r\n    success: function (res) {\r\n      if (res.lang) {\r\n        lang_json = res.lang;\r\n      }\r\n\r\n      if (res.file) {\r\n        folder_id = res.file.folder_id;\r\n        file_chk = res.file.file_chk;\r\n        userid = res.file.userid;\r\n        popad = res.file.popad || 0;  // Save global popads value\r\n        // Update share_id if provided in response\r\n        if (res.file.share_id) {\r\n          share_id = res.file.share_id;\r\n        }\r\n      }\r\n\r\n      if (res.code == 200) {\r\n        //ok to login\r\n\r\n        var dir_template = \"dir-content.php\";\r\n        if (res.file.is_mb) {\r\n          dir_template = \"dir-content-mb.php\";\r\n        }\r\n\r\n        // Reset selection state when loading new directory\r\n        resetSelectionState();\r\n\r\n        $(\"#main-content\").load(\r\n          template_url + \"/template/\" + dir_template + \"?pop=\" + res.file.popad,\r\n          function () {\r\n            document.title = res.file.page_title;\r\n            rivets.bind($(\"body\"), { file: res.file, lang: lang_json });\r\n            hide_loader();\r\n            loadtextad();\r\n\r\n            $.fn.dataTable.ext.errMode = 'none';\r\n            var oTable = $(\"#table_files\").DataTable({\r\n              bProcessing: false,\r\n              bServerSide: true,\r\n              bAutoWidth: false,\r\n              sAjaxSource: api_server + res.file.url,\r\n              responsive: false,\r\n              //\"pagingType\":\"simple\",\r\n              lengthChange: res.file.is_mb ? false : true,\r\n              searching: true, // Enable search for both mobile and desktop\r\n              language: lang_json[\"datatables\"],\r\n              columnDefs: res.file.is_mb ? [] : [\r\n                { targets: 0, className: 'text-center checkbox-column' },        // Checkbox column\r\n                { targets: 1, className: 'truncate-filename' },  // Filename column\r\n                { targets: 2, className: 'truncate-size text-center' },     // Size column\r\n                { targets: 3, className: 'truncate-date text-center' }      // Date column\r\n              ],\r\n              initComplete: function () {\r\n                // Set placeholder from language pack\r\n                var searchPlaceholder = lang_json['datatables']['searchPlaceholder'] || '搜索文件...';\r\n                $('#table_files_filter input').attr('placeholder', searchPlaceholder);\r\n              },\r\n              drawCallback: function (settings) {\r\n                if (res.file.is_mb) {\r\n                  $(\".dataTables_paginate\").addClass(\r\n                    \"d-flex justify-content-center\"\r\n                  );\r\n                  // Mobile - no checkbox restoration needed\r\n                  return;\r\n                }\r\n\r\n                // Desktop - restore checkbox states after draw\r\n                console.log('DataTable redrawn, restoring checkboxes. Selected:', checkedIDs.length);\r\n\r\n                // Show/hide checkbox column based on selections\r\n                if (checkedIDs.length > 0 && !isCheckboxColumnVisible) {\r\n                  toggleDataTableCheckbox(true);\r\n                } else if (checkedIDs.length === 0 && !isCheckboxColumnVisible) {\r\n                  toggleDataTableCheckbox(false);\r\n                }\r\n\r\n                // Restore checkbox states\r\n                if (checkedIDs.length > 0) {\r\n                  var restoredCount = 0;\r\n                  $('.checkbox-bulk-select-target').each(function () {\r\n                    var value = $(this).val();\r\n                    if (checkedIDs.indexOf(value) !== -1) {\r\n                      $(this).prop('checked', true);\r\n                      restoredCount++;\r\n                    }\r\n                  });\r\n\r\n                  console.log('Restored', restoredCount, 'checkboxes on current page');\r\n\r\n                  // Update select-all checkbox\r\n                  var pageTotal = $('.checkbox-bulk-select-target').length;\r\n                  var pageChecked = $('.checkbox-bulk-select-target:checked').length;\r\n                  $('#select-all-checkbox').prop('checked', pageTotal > 0 && pageTotal === pageChecked);\r\n                }\r\n              },\r\n              pageLength: 10,\r\n              lengthMenu: [\r\n                [10, 25, 50, 100, 200],\r\n                [10, 25, 50, 100, 200],\r\n              ],\r\n              pagingType: res.file.is_mb ? \"full\" : \"full_numbers\",\r\n              aaSorting: res.file.is_mb ? [] : [[3, \"desc\"]],\r\n              aoColumns: res.file.is_mb\r\n                ? [{ bSortable: false, sWidth: \"40px\" }, { sClass: \"file-cell\", bSortable: true }] // Mobile: 2 columns (checkbox + content)\r\n                : [\r\n                  { bSortable: false, sWidth: \"40px\" },\r\n                  null,\r\n                  { sClass: \"text-center\", sWidth: \"110px\" },\r\n                  { sClass: \"text-center\", sWidth: \"110px\" },\r\n                ],\r\n              columnDefs: res.file.is_mb ? [\r\n                {\r\n                  targets: 0, // Checkbox column (mobile)\r\n                  visible: false // Hide checkbox column by default\r\n                }\r\n              ] : [\r\n                {\r\n                  targets: 0, // Checkbox column (desktop)\r\n                  visible: false // Hide checkbox column by default\r\n                }\r\n              ],\r\n            });\r\n\r\n            var input_filter_value;\r\n            var input_filter_timeout = null;\r\n            $(\"div.dataTables_filter input\").unbind();\r\n            $(\"div.dataTables_filter input\").on('input', function (e) {\r\n              input_filter_value = this.value;\r\n              clearTimeout(input_filter_timeout);\r\n\r\n              if (input_filter_value === '') {\r\n                // Immediate search when input is cleared\r\n                oTable.search('').draw();\r\n              } else {\r\n                // Delayed search for typed content\r\n                input_filter_timeout = setTimeout(function () {\r\n                  oTable.search(input_filter_value).draw();\r\n                }, 1000);\r\n              }\r\n            });\r\n\r\n\r\n          }\r\n        );\r\n\r\n        if (res.file.doubleclick_url) {\r\n          $(\"#doubleclick_log\").attr(\"data\", res.file.doubleclick_url);\r\n        }\r\n\r\n        if (res.file.xtredirect && res.file.forceApp) {\r\n          setTimeout(function () {\r\n            window.location.href = \"ctfile://\" + res.file.xtredirect;\r\n          }, 3000);\r\n        }\r\n      } else {\r\n        error_code_handler(res);\r\n      }\r\n    },\r\n  });\r\n}\r\n\r\nfunction load_dir(query, path) {\r\n  var folder_key = urlComponent.query[\"fk\"] || \"\"; // Get folder key from URL parameter\r\n\r\n  $.ajax({\r\n    type: \"GET\",\r\n    url:\r\n      api_server +\r\n      \"/getdir.php?path=\" +\r\n      path +\r\n      \"&d=\" +\r\n      query +\r\n      \"&folder_id=\" +\r\n      urlComponent.query[\"d\"] +\r\n      \"&fk=\" +\r\n      folder_key +\r\n      \"&passcode=\" +\r\n      passcode +\r\n      \"&r=\" +\r\n      Math.random() +\r\n      \"&ref=\" +\r\n      encodeURIComponent(document.referrer) +\r\n      \"&url=\" +\r\n      encodeURIComponent(top.location.href),\r\n    dataType: \"json\",\r\n    headers: getAjaxHeaders(),\r\n    success: function (res) {\r\n      if (res.lang) {\r\n        lang_json = res.lang;\r\n      }\r\n\r\n      if (res.file) {\r\n        folder_id = res.file.folder_id;\r\n        file_chk = res.file.file_chk;\r\n        userid = res.file.userid;\r\n        popad = res.file.popad || 0;  // Save global popads value\r\n      }\r\n\r\n      if (res.code == 200) {\r\n        //ok to login\r\n\r\n        var dir_template = \"dir-content.php\";\r\n        if (res.file.is_mb) {\r\n          dir_template = \"dir-content-mb.php\";\r\n        }\r\n\r\n        // Reset selection state when loading new directory\r\n        resetSelectionState();\r\n\r\n        $(\"#main-content\").load(\r\n          template_url + \"/template/\" + dir_template + \"?pop=\" + res.file.popad,\r\n          function () {\r\n            document.title = res.file.page_title;\r\n            rivets.bind($(\"body\"), { file: res.file, lang: lang_json });\r\n            hide_loader();\r\n            loadtextad();\r\n\r\n            $.fn.dataTable.ext.errMode = 'none';\r\n            var oTable = $(\"#table_files\").DataTable({\r\n              bProcessing: false,\r\n              bServerSide: true,\r\n              bAutoWidth: false,\r\n              sAjaxSource: api_server + res.file.url,\r\n              responsive: false,\r\n              //\"pagingType\":\"simple\",\r\n              lengthChange: res.file.is_mb ? false : true,\r\n              searching: true, // Enable search for both mobile and desktop\r\n              language: lang_json[\"datatables\"],\r\n              columnDefs: res.file.is_mb ? [] : [\r\n                { targets: 0, className: 'text-center checkbox-column' },        // Checkbox column\r\n                { targets: 1, className: 'truncate-filename' },  // Filename column\r\n                { targets: 2, className: 'truncate-size text-center' },     // Size column\r\n                { targets: 3, className: 'truncate-date text-center' }      // Date column\r\n              ],\r\n              initComplete: function () {\r\n                // Set placeholder from language pack\r\n                var searchPlaceholder = lang_json['datatables']['searchPlaceholder'] || '搜索文件...';\r\n                $('#table_files_filter input').attr('placeholder', searchPlaceholder);\r\n              },\r\n              drawCallback: function (settings) {\r\n                if (res.file.is_mb) {\r\n                  $(\".dataTables_paginate\").addClass(\r\n                    \"d-flex justify-content-center\"\r\n                  );\r\n                  // Mobile - no checkbox restoration needed\r\n                  return;\r\n                }\r\n\r\n                // Desktop - restore checkbox states after draw\r\n                console.log('DataTable redrawn, restoring checkboxes. Selected:', checkedIDs.length);\r\n\r\n                // Show/hide checkbox column based on selections\r\n                if (checkedIDs.length > 0 && !isCheckboxColumnVisible) {\r\n                  toggleDataTableCheckbox(true);\r\n                } else if (checkedIDs.length === 0 && !isCheckboxColumnVisible) {\r\n                  toggleDataTableCheckbox(false);\r\n                }\r\n\r\n                // Restore checkbox states\r\n                if (checkedIDs.length > 0) {\r\n                  var restoredCount = 0;\r\n                  $('.checkbox-bulk-select-target').each(function () {\r\n                    var value = $(this).val();\r\n                    if (checkedIDs.indexOf(value) !== -1) {\r\n                      $(this).prop('checked', true);\r\n                      restoredCount++;\r\n                    }\r\n                  });\r\n\r\n                  console.log('Restored', restoredCount, 'checkboxes on current page');\r\n\r\n                  // Update select-all checkbox\r\n                  var pageTotal = $('.checkbox-bulk-select-target').length;\r\n                  var pageChecked = $('.checkbox-bulk-select-target:checked').length;\r\n                  $('#select-all-checkbox').prop('checked', pageTotal > 0 && pageTotal === pageChecked);\r\n                }\r\n              },\r\n              pageLength: 10,\r\n              lengthMenu: [\r\n                [10, 25, 50, 100, 200],\r\n                [10, 25, 50, 100, 200],\r\n              ],\r\n              pagingType: res.file.is_mb ? \"full\" : \"full_numbers\",\r\n              aaSorting: res.file.is_mb ? [] : [[3, \"desc\"]],\r\n              aoColumns: res.file.is_mb\r\n                ? [{ bSortable: false, sWidth: \"40px\" }, { sClass: \"file-cell\", bSortable: true }] // Mobile: 2 columns (checkbox + content)\r\n                : [\r\n                  { bSortable: false, sWidth: \"40px\" },\r\n                  null,\r\n                  { sClass: \"text-center\", sWidth: \"110px\" },\r\n                  { sClass: \"text-center\", sWidth: \"110px\" },\r\n                ],\r\n              columnDefs: res.file.is_mb ? [\r\n                {\r\n                  targets: 0, // Checkbox column (mobile)\r\n                  visible: false // Hide checkbox column by default\r\n                }\r\n              ] : [\r\n                {\r\n                  targets: 0, // Checkbox column (desktop)\r\n                  visible: false // Hide checkbox column by default\r\n                }\r\n              ],\r\n            });\r\n\r\n            var input_filter_value;\r\n            var input_filter_timeout = null;\r\n            $(\"div.dataTables_filter input\").unbind();\r\n            $(\"div.dataTables_filter input\").on('input', function (e) {\r\n              input_filter_value = this.value;\r\n              clearTimeout(input_filter_timeout);\r\n\r\n              if (input_filter_value === '') {\r\n                // Immediate search when input is cleared\r\n                oTable.search('').draw();\r\n              } else {\r\n                // Delayed search for typed content\r\n                input_filter_timeout = setTimeout(function () {\r\n                  oTable.search(input_filter_value).draw();\r\n                }, 1000);\r\n              }\r\n            });\r\n\r\n\r\n          }\r\n        );\r\n\r\n        if (res.file.doubleclick_url) {\r\n          $(\"#doubleclick_log\").attr(\"data\", res.file.doubleclick_url);\r\n        }\r\n\r\n        if (res.file.xtredirect && res.file.forceApp) {\r\n          setTimeout(function () {\r\n            window.location.href = \"ctfile://\" + res.file.xtredirect;\r\n          }, 3000);\r\n        }\r\n      } else {\r\n        error_code_handler(res);\r\n      }\r\n    },\r\n  });\r\n}\r\n\r\nfunction load_buy_premium(is_gb, query) {\r\n  $.ajax({\r\n    type: \"GET\",\r\n    url:\r\n      api_server +\r\n      \"/getpremium.php?gb=\" +\r\n      is_gb +\r\n      \"&l=\" +\r\n      query +\r\n      \"&r=\" +\r\n      Math.random() +\r\n      \"&ref=\" +\r\n      encodeURIComponent(document.referrer) +\r\n      \"&url=\" +\r\n      encodeURIComponent(top.location.href),\r\n    dataType: \"json\",\r\n    headers: getAjaxHeaders(),\r\n    success: function (res) {\r\n      if (res.lang) {\r\n        lang_json = res.lang;\r\n      }\r\n\r\n      if (res.code == 200 && res.file) {\r\n        var buy_premium_template = \"buy-premium.php\";\r\n        if (res.file.is_mb) {\r\n          buy_premium_template = \"buy-premium-mb.php\";\r\n        }\r\n        $(\"#main-content\").load(\r\n          template_url + \"/template/\" + buy_premium_template + \"?pop=\" + res.file.popad,\r\n          function () {\r\n            document.title = res.file.page_title;\r\n            rivets.bind($(\"body\"), { file: res.file, lang: lang_json });\r\n            hide_loader();\r\n            // page_right_register();\r\n\r\n            loadtextad();\r\n          }\r\n        );\r\n\r\n        if (res.file.doubleclick_url) {\r\n          $(\"#doubleclick_log\").attr(\"data\", res.file.doubleclick_url);\r\n        }\r\n      } else {\r\n        error_code_handler(res);\r\n      }\r\n    },\r\n  });\r\n}\r\n\r\n\r\nfunction load_list(query, path) {\r\n  $.ajax({\r\n    type: \"GET\",\r\n    url:\r\n      api_server +\r\n      \"/getlist.php?path=\" +\r\n      path +\r\n      \"&d=\" +\r\n      query +\r\n      \"&type_id=\" +\r\n      window.location.search.substring(1) +\r\n      \"&passcode=\" +\r\n      passcode +\r\n      \"&r=\" +\r\n      Math.random() +\r\n      \"&ref=\" +\r\n      encodeURIComponent(document.referrer) +\r\n      \"&url=\" +\r\n      encodeURIComponent(top.location.href),\r\n    dataType: \"json\",\r\n    headers: getAjaxHeaders(),\r\n    success: function (res) {\r\n      if (res.lang) {\r\n        lang_json = res.lang;\r\n      }\r\n\r\n      if (res.code == 200) {\r\n        //ok to login\r\n\r\n        var dir_template = \"list-content.php\";\r\n        if (res.file.is_mb) {\r\n          dir_template = \"list-content-mb.php\";\r\n        }\r\n\r\n        // Reset selection state when loading new list\r\n        resetSelectionState();\r\n\r\n        $(\"#main-content\").load(\r\n          template_url + \"/template/\" + dir_template + \"?pop=\" + res.file.popad,\r\n          function () {\r\n            document.title = res.file.page_title;\r\n            rivets.bind($(\"body\"), { file: res.file, lang: lang_json });\r\n            hide_loader();\r\n            loadtextad();\r\n\r\n            var oTable = $(\"#table_files\").DataTable({\r\n              bProcessing: false,\r\n              bServerSide: true,\r\n              bAutoWidth: false,\r\n              sAjaxSource: api_server + res.file.url,\r\n              responsive: false,\r\n              \"bSort\": false,\r\n              //\"pagingType\":\"simple\",\r\n              lengthChange: res.file.is_mb ? false : true,\r\n              searching: allowSearch,\r\n              language: lang_json[\"datatables\"],\r\n              columnDefs: res.file.is_mb ? [] : [\r\n                { targets: 0, className: 'truncate-filename' },  // Filename column\r\n                { targets: 1, className: 'truncate-size text-center' },     // Size column\r\n                { targets: 2, className: 'truncate-text text-center' },     // Uploader column\r\n                { targets: 3, className: 'truncate-date text-center' }      // Date column\r\n              ],\r\n              drawCallback: function () {\r\n                if (res.file.is_mb) {\r\n                  $(\".dataTables_paginate\").addClass(\r\n                    \"d-flex justify-content-center\"\r\n                  );\r\n                }\r\n              },\r\n              pageLength: 25,\r\n              lengthMenu: [\r\n                [10, 25, 50, 100, 200],\r\n                [10, 25, 50, 100, 200],\r\n              ],\r\n              pagingType: res.file.is_mb ? \"full\" : \"full_numbers\",\r\n              aoColumns: res.file.is_mb\r\n                ? [{ sClass: \"file-cell\", bSortable: true }] // Mobile: single column with sorting\r\n                : [\r\n                  null,\r\n                  { sClass: \"text-center\", sWidth: \"110px\" },\r\n                  { sClass: \"text-center\", sWidth: \"150px\" },\r\n                  { sClass: \"text-center\", sWidth: \"110px\" },\r\n                ],\r\n            });\r\n\r\n            var input_filter_value;\r\n            var input_filter_timeout = null;\r\n            $(\"div.dataTables_filter input\").unbind();\r\n            $(\"div.dataTables_filter input\").on('input', function (e) {\r\n              input_filter_value = this.value;\r\n              clearTimeout(input_filter_timeout);\r\n\r\n              if (input_filter_value === '') {\r\n                // Immediate search when input is cleared\r\n                oTable.search('').draw();\r\n              } else {\r\n                // Delayed search for typed content\r\n                input_filter_timeout = setTimeout(function () {\r\n                  oTable.search(input_filter_value).draw();\r\n                }, 1000);\r\n              }\r\n            });\r\n\r\n\r\n\r\n            setInterval(function () {\r\n              oTable.ajax.reload();\r\n            }, 90000);\r\n\r\n\r\n\r\n\r\n          }\r\n        );\r\n      } else {\r\n        error_code_handler(res);\r\n      }\r\n    },\r\n  });\r\n\r\n\r\n}\r\n\r\n\r\n\r\nfunction verify_passcode() {\r\n  if (!$(\"#passcode\").val()) {\r\n    return false;\r\n  }\r\n\r\n  $.ajax({\r\n    type: \"GET\",\r\n    url:\r\n      api_server +\r\n      \"/passcode.php?file_id=\" +\r\n      file_id +\r\n      \"&folder_id=\" +\r\n      folder_id +\r\n      \"&userid=\" +\r\n      userid +\r\n      \"&passcode=\" +\r\n      $(\"#passcode\").val() +\r\n      \"&r=\" +\r\n      Math.random(),\r\n    dataType: \"json\",\r\n    headers: getAjaxHeaders(),\r\n    success: function (res) {\r\n      if (res.code == 200) {\r\n        passcode = res.file.passcode;\r\n        localStorage.setItem(\"passcode-\" + filequery, res.file.passcode);\r\n        init_load();\r\n      } else {\r\n        error_code_handler(res);\r\n      }\r\n    },\r\n  });\r\n}\r\n\r\nfunction init_load() {\r\n\r\n  const authCode = getAuthCodeFromUrl();\r\n\r\n  if (authCode) {\r\n    // Exchange auth_code for session token (synchronous request)\r\n    $.ajax({\r\n      url: api_server + '/api.php?item=account&action=auth_code_exchange',\r\n      type: 'POST',\r\n      data: { auth_code: authCode },\r\n      dataType: 'json',\r\n      async: false,  // Make request synchronous\r\n      success: function (response) {\r\n        if (response.code === 200) {\r\n          // Store session token\r\n          if (response.session_id) {\r\n            localStorage.setItem('session_token', response.session_id);\r\n          }\r\n\r\n          // Clean up URL - remove auth_code parameter\r\n          const cleanUrl = window.location.href.replace(/[?&]auth_code=[^&]+/, '');\r\n          window.history.replaceState({}, document.title, cleanUrl);\r\n        } else {\r\n          console.error('Auth code exchange failed:', response.message);\r\n        }\r\n      },\r\n      error: function () {\r\n        console.error('Failed to exchange auth code');\r\n      }\r\n    });\r\n  }\r\n\r\n  urlComponent = parseLocationUrl();\r\n  var path = urlComponent.path.split(\"/\");\r\n\r\n  if (path.length < 3) {\r\n    $(\"#main-content\").load(template_url + \"/template/file-notfound.php\",\r\n      function () {\r\n        hide_loader();\r\n      }\r\n    );\r\n    document.title = \"File Not Found\";\r\n    return;\r\n  }\r\n\r\n  filequery = path[2];\r\n\r\n  passcode = localStorage.getItem(\"passcode-\" + filequery);\r\n  if (!passcode) {\r\n    passcode = \"\";\r\n  }\r\n\r\n  if (path[1].indexOf(\"f\") == 0) {\r\n    load_file(filequery, path[1]);\r\n  }\r\n\r\n  if (path[1].indexOf(\"d\") == 0) {\r\n    load_dir(filequery, path[1]);\r\n  }\r\n\r\n  if (path[1].indexOf(\"l\") == 0) {\r\n    load_list(filequery, path[1]);\r\n  }\r\n\r\n  if (path[1].indexOf(\"s\") == 0) {\r\n    load_share(filequery, path[1]);\r\n  }\r\n\r\n  if (path[1].indexOf(\"premium\") == 0) {\r\n    //path[2] is global or not , path[3] is error code\r\n    load_buy_premium(filequery, path[3]);\r\n  }\r\n}\r\n\r\nfunction getTokenId() {\r\n  // Check for the real session token from authentication\r\n  var sessionToken = localStorage.getItem(\"session_token\");\r\n  if (sessionToken) {\r\n    return sessionToken;\r\n  }\r\n\r\n  // Check if we're on the main domain (ctfile.com uses cookies, not tokens)\r\n  var isInsideDomain =\r\n    window.location.host.indexOf(main_domain) > 0 ? true : false;\r\n  if (isInsideDomain) {\r\n    return \"0\";\r\n  }\r\n\r\n  // No token available for cross-domain\r\n  return \"0\";\r\n}\r\n\r\n// Helper function to get common AJAX headers with Authorization\r\nfunction getAjaxHeaders() {\r\n  var token = getTokenId();\r\n  if (token && token !== \"0\") {\r\n    return {\r\n      'Authorization': 'Bearer ' + token\r\n    };\r\n  }\r\n  return {};\r\n}\r\n\r\nasync function isFetchAPISupported(filesize) {\r\n  var abortCtl = \"AbortController\" in window;\r\n\r\n  if (abortCtl && \"storage\" in navigator && \"estimate\" in navigator.storage) {\r\n    var storageSpace = await navigator.storage.estimate();\r\n    if (storageSpace.quota > filesize) {\r\n      return true;\r\n    }\r\n  }\r\n  return false;\r\n}\r\n\r\nfunction isDownloadTagSupported() {\r\n  var a = document.createElement(\"a\");\r\n  if (typeof a.download != \"undefined\") {\r\n    return true;\r\n  }\r\n  return false;\r\n}\r\n\r\nfunction load_passcode() {\r\n  var temp_passcode = urlComponent.query[\"p\"];\r\n  // var isInsideDomain = window.location.host.indexOf(\".ctfile.com\") > 0 ? true : false;\r\n  if (temp_passcode && $(\"#passcode\").val().trim() == \"\" && pass_autocomplete) {\r\n    $(\"#passcode\").val(temp_passcode);\r\n  }\r\n}\r\n\r\nfunction auto_submitpasscode() {\r\n  setTimeout(function () { load_passcode(); }, 1000);\r\n  setTimeout(function () { verify_passcode(); }, 2000);\r\n}\r\n\r\nfunction prettyBytes(num) {\r\n  // jacked from: https://github.com/sindresorhus/pretty-bytes\r\n  if (typeof num !== \"number\" || isNaN(num)) {\r\n    throw new TypeError(\"Expected a number\");\r\n  }\r\n\r\n  var exponent;\r\n  var unit;\r\n  var neg = num < 0;\r\n  var units = [\"B\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\", \"EB\", \"ZB\", \"YB\"];\r\n\r\n  if (neg) {\r\n    num = -num;\r\n  }\r\n\r\n  if (num < 1) {\r\n    return (neg ? \"-\" : \"\") + num + \" B\";\r\n  }\r\n\r\n  exponent = Math.min(\r\n    Math.floor(Math.log(num) / Math.log(1000)),\r\n    units.length - 1\r\n  );\r\n  num = (num / Math.pow(1000, exponent)).toFixed(2) * 1;\r\n  unit = units[exponent];\r\n\r\n  return (neg ? \"-\" : \"\") + num + \" \" + unit;\r\n}\r\nfunction convertFileIcon(ext) {\r\n  var svg = \"file\";\r\n  if (\r\n    /^(folder|ai|apk|css|font|iso|jpg|js|mp3|mp4|doc|xls|ppt|zip|sql|svg|ttf|txtpdf|php|psd|vcf|pdf)$/.test(\r\n      ext\r\n    )\r\n  ) {\r\n    svg = ext;\r\n  } else if (/^(ppt|pptx)$/.test(ext)) {\r\n    svg = \"ppt\";\r\n  } else if (/^(doc|docx|wps|dotx)$/.test(ext)) {\r\n    svg = \"docx\";\r\n  } else if (/^(xls|xlsx)$/.test(ext)) {\r\n    svg = \"xls\";\r\n  } else if (/^(zip|rar|iso|7z|tar|gz|rpm)$/.test(ext)) {\r\n    svg = \"zip\";\r\n  } else if (/^(json|conf|asp|class|java|dll)$/.test(ext)) {\r\n    svg = \"code\";\r\n  } else if (/^(ipa|msi|apk|exe)$/.test(ext)) {\r\n    svg = \"disc\";\r\n  } else if (/^(aac|amr|ape|flac|m4a|m4b|m4p|mmf|mp3|wav|wma)$/.test(ext)) {\r\n    svg = \"music\";\r\n  } else if (\r\n    /^(mov|mp4|mpg|mpeg|webm|mkv|flv|vob|ogg|avi|wmv|rm|rmvb|3gp)$/.test(ext)\r\n  ) {\r\n    svg = \"play\";\r\n  } else if (/^(jpg|jpeg|png|gif|bmp|ico)$/.test(ext)) {\r\n    svg = \"jpg\";\r\n  }\r\n  return \"assets/svg/filetypes/\" + svg + \".svg\";\r\n}\r\n\r\nfunction remainingTime(second, showSeconds) {\r\n  if (!lang_json) {\r\n    return null;\r\n  }\r\n  if (showSeconds === undefined) {\r\n    showSeconds = true;\r\n  }\r\n  var hours = parseInt(second / 60 / 60);\r\n  var minutes = parseInt((second / 60) % 60);\r\n  var seconds = parseInt(second % 60);\r\n  var result;\r\n  if (hours > 0 && !showSeconds) {\r\n    // 有小时且不需要显示秒时，只显示小时和分钟\r\n    result = hours + lang_json[\"measurements\"][\"hour\"] +\r\n             minutes + lang_json[\"measurements\"][\"minute\"];\r\n  } else {\r\n    // 完整显示\r\n    result = (hours ? hours + lang_json[\"measurements\"][\"hour\"] : \"\") +\r\n             minutes + lang_json[\"measurements\"][\"minute\"] +\r\n             seconds + lang_json[\"measurements\"][\"second\"];\r\n  }\r\n  return result.replace(/\\b(\\d)\\b/g, \"0$1\");\r\n}\r\n\r\n\r\n(function () {\r\n\r\n  // Global AJAX setup\r\n  $.ajaxSetup({\r\n    xhrFields: {\r\n      withCredentials: true,\r\n    },\r\n    crossDomain: true,\r\n  });\r\n\r\n  // Global authentication error handler\r\n  function handleAuthenticationRequired(xhr) {\r\n    // Prevent multiple redirects\r\n    if (window.redirecting) return;\r\n    window.redirecting = true;\r\n\r\n    // Parse response if possible\r\n    var response = null;\r\n    try {\r\n      response = xhr.responseJSON || JSON.parse(xhr.responseText);\r\n    } catch (e) {\r\n      response = { message: 'Authentication required' };\r\n    }\r\n\r\n    // Show message to user (if toast function exists)\r\n    if (typeof showToast === 'function') {\r\n      showToast(response.message || '请先登录');\r\n    }\r\n\r\n    // Redirect to login page after a short delay\r\n    setTimeout(function () {\r\n      var loginUrl = response.login_url || 'https://www.ctfile.com/login';\r\n      top.location.href = loginUrl + '?ref=' + encodeURIComponent(top.location.href);\r\n    }, 500);\r\n  }\r\n\r\n  // Hook into jQuery AJAX to handle authentication errors globally\r\n  $(document).ajaxError(function (event, xhr, settings, thrownError) {\r\n    // Handle HTTP 401 status - always means authentication required\r\n    if (xhr.status === 401) {\r\n      handleAuthenticationRequired(xhr);\r\n    }\r\n  });\r\n\r\n  $(document).ajaxComplete(function (event, xhr, settings) {\r\n    // Handle 401 code in response body - always means authentication required\r\n    if (xhr.responseJSON && xhr.responseJSON.code === 401) {\r\n      handleAuthenticationRequired(xhr);\r\n    }\r\n  });\r\n\r\n  if ($(\"#infoModal\").length == 0) {\r\n    $(\"body\").append('<div class=\"modal fade\" id=\"infoModal\" tabindex=\"-1\" role=\"dialog\" aria-hidden=\"true\"></div>');\r\n  }\r\n\r\n  var copyxtlink = new ClipboardJS(\"#xtlink_copybtn\");\r\n  copyxtlink.on(\"success\", function (e) {\r\n    ctsuccess(lang_json[\"copy_success_open_app\"]);\r\n  });\r\n\r\n  copyxtlink.on(\"error\", function (e) {\r\n    cterror(lang_json[\"copy_failed_open_app\"]);\r\n  });\r\n\r\n  const originalPushState = history.pushState;\r\n  // 重写 pushState\r\n  history.pushState = function (...args) {\r\n    console.log('pushState triggered');\r\n    const result = originalPushState.apply(this, args);\r\n    window.dispatchEvent(new Event('hashchange')); // 手动触发 hashchange 事件\r\n    return result;\r\n  };\r\n  window.addEventListener('popstate', (event) => {\r\n    console.log('popstate triggered');\r\n    init_load();\r\n  });\r\n\r\n  window.addEventListener('hashchange', () => {\r\n    console.log('Hashchange triggered:', window.location.hash);\r\n    init_load();\r\n  });\r\n\r\n\r\n\r\n  init_load();\r\n\r\n  setTimeout(function () {\r\n    var appBar = document.getElementById('appDownloadBar');\r\n    var fabButton = document.getElementById('appDownloadFab');\r\n\r\n    if (appBar) {\r\n      appBar.style.display = 'none';\r\n    }\r\n\r\n    if (fabButton) {\r\n      fabButton.style.display = 'flex';\r\n    }\r\n  }, 5000);\r\n})();\r\n"
