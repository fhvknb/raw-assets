            "mimeType": "text/html",
            "text": "<div class=\"container\">\r\n    <div class=\"row flex-center min-vh-100 py-6 text-center\">\r\n        <div class=\"card mb-3\">\r\n            <div class=\"card-body overflow-hidden text-center pt-5\">\r\n                <div class=\"row justify-content-center\">\r\n                    <div class=\"col-7 col-md-5\"><img class=\"img-fluid\" src=\"https://webstatic.ctfile.com/assets/img/illustrations/gifts.jpg\" alt=\"\"></div>\r\n                </div>\r\n                <h3 class=\"mt-3 mt-md-4 font-weight-normal fs-2 fs-md-3\">{ lang.domain_setup.congrats_title }</h3>\r\n                <p class=\"lead\">{ lang.domain_setup.copy_instruction } <strong id=\"shareweburl\"></strong> { lang.domain_setup.copy_instruction_submit }</p>\r\n\r\n            </div>\r\n            <div class=\"card-footer d-flex justify-content-center bg-light text-center pt-4\">\r\n                <div class=\"col-10\">\r\n                    <h4 class=\"font-weight-normal mb-3 fs-1 fs-md-2\">{ lang.domain_setup.benefits_title }</h4>\r\n                    <p class=\"mb-2 fs--1\">{ lang.domain_setup.benefits_desc }<br class=\"d-none d-md-block\">{ lang.domain_setup.benefits_desc2 }</p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n<script>\r\n    $(\"#shareweburl\").text(top.location.href);\r\n</script>"
